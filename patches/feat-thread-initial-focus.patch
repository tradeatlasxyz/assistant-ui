@@ -0,0 +1,240 @@
+"use client";
+
+import { Primitive } from "@radix-ui/react-primitive";
+import {
+  type ComponentRef,
+  forwardRef,
+  ComponentPropsWithoutRef,
+  useCallback,
+  useContext,
+  useEffect,
+  useRef,
+} from "react";
+import { useAui, useAuiState } from "@assistant-ui/store";
+import { useManagedRef } from "../../utils/hooks/useManagedRef";
+import "./message-root.css";
+import { useSizeHandle } from "../../utils/hooks/useSizeHandle";
+import { useComposedRefs } from "@radix-ui/react-compose-refs";
+import { useThreadViewport } from "../../context/react/ThreadViewportContext";
+import { ThreadPrimitiveViewportSlack } from "../thread/ThreadViewportSlack";
+import { useThreadKeyboardNav } from "../thread/ThreadViewport";
+
+export namespace MessagePrimitiveRoot {
+  export type Element = ComponentRef<typeof Primitive.div>;
+  export type Props = ComponentPropsWithoutRef<typeof Primitive.div> & {};
+}
+
+const MessagePrimitiveRoot = forwardRef<MessagePrimitiveRoot.Element, MessagePrimitiveRoot.Props>(
+  ({ children, ...rest }, forwardedRef) => {
+    const elRef = useRef<HTMLDivElement | null>(null);
+    const composed = useComposedRefs(forwardedRef, (node: HTMLDivElement | null) => {
+      elRef.current = node;
+    });
+
+    const keyboardNav = useThreadKeyboardNav();
+
+    // stable id for aria and registration
+    const messageId = rest.id ?? `thread-message-${Math.random().toString(36).slice(2, 9)}`;
+
+    useEffect(() => {
+      const el = elRef.current;
+      if (keyboardNav) {
+        try {
+          keyboardNav.registerMessage(messageId, el ?? null);
+        } catch (err) {
+          // ignore
+        }
+      }
+      return () => {
+        try {
+          keyboardNav?.unregisterMessage(messageId);
+        } catch (err) {
+          // ignore
+        }
+      };
+    }, [keyboardNav, messageId]);
+
+    const isActive = keyboardNav?.activeId === messageId;
+    const index = keyboardNav?.getIndexById ? keyboardNav.getIndexById(messageId) : null;
+    const setsize = keyboardNav?.getTotal ? keyboardNav.getTotal() : undefined;
+
+    return (
+      <Primitive.div
+        {...rest}
+        id={messageId}
+        ref={composed as any}
+        role="option"
+        aria-posinset={index !== null && index !== undefined ? index + 1 : undefined}
+        aria-setsize={setsize}
+        tabIndex={isActive ? 0 : -1}
+        className={isActive ? "thread-message thread-message--focused" : "thread-message"}
+      >
+        {children}
+      </Primitive.div>
+    );
+  },
+);
+
+export { MessagePrimitiveRoot as MessageRoot };
+
